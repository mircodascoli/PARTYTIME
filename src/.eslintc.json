{
  "root": true,
  "extends": ["airbnb-base", "prettier"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "import/extensions": ["error", "ignorePackages"],
    "import/no-extraneous-dependencies": ["error", { "devDependencies": true }],
    "no-console": "warn"
    
  }
}
