{
  "name": "Partytime",
  "version": "1.0.0",
  "description": "Progetto didattico per esercitarsi con Node.js, Express e Lit",
  "main": "server/server.express.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env server/server.express.js",
    "dev": "node --env-file=.env --watch server/server.express.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "jsdoc ./src -r"
  },
  "keywords": [
    "node",
    "express",
    "lit",
    "mongodb",
    "supabase"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mircodascoli/Neoland.git"
  },
  "author": "Mirco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mircodascoli/Neoland/issues"
  },
  "homepage": "https://github.com/mircodascoli/Neoland#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.1",
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.4",
    "prettier": "^3.9.6",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "lit": "^3.3.0",
    "mongodb": "^6.16.0",
    "nodemailer": "^9.0.3",
    "serverless-http": "^3.2.0"
  }
}
